# Normalize line endings so the working tree, the index and CI agree on bytes (stops LF/CRLF churn).
* text=auto eol=lf

# Shell scripts and the PKGBUILD stay LF.
*.sh text eol=lf
PKGBUILD text eol=lf

# Never normalize these: Git must not rewrite their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.pdf binary
*.zip binary
